[Unit]
Description=Check in with the kiosk manager (and GitHub) once after start-up
# Fires every 5 minutes, but "kiosk-checkin start-up" stops doing anything once the manager
# has answered, so each kiosk checks in about once per start-up (and late Wi-Fi still works).

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
