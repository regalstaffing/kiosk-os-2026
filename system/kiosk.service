[Unit]
Description=Kiosk browser (cage + Chromium)
After=systemd-user-sessions.service plymouth-quit.service kiosk-update.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
# Keep startup messages off the kiosk screen
StandardOutput=journal
StandardError=journal
# Browser profile lives in memory: kiosk-browser recreates it for every
# session, and systemd deletes it whenever the service stops
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
# Disable Ctrl+Alt+Fn console switching and Ctrl+Alt+Backspace
Environment=XKB_DEFAULT_OPTIONS=srvrkeys:none
ExecStart=/usr/bin/cage -d -- /usr/local/bin/kiosk-browser
Restart=always
RestartSec=2
# The profile is wiped anyway: end Chromium at once instead of letting it
# shut down slowly, and never wait long for a clean exit
ExecStop=-/usr/bin/pkill -KILL -u kiosk -f /usr/lib/chromium/
TimeoutStopSec=3

[Install]
WantedBy=graphical.target
