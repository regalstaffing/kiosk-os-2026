[Unit]
Description=Kiosk update check at boot
Wants=network-online.target
After=network-online.target kiosk-firstboot.service
# Keep the boot splash up while the check runs
Before=kiosk.service plymouth-quit.service plymouth-quit-wait.service
# setup.sh writes this file, so the check is skipped until first setup is done
ConditionPathExists=/etc/kiosk/repo

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kiosk-autoupdate
# Then apply this kiosk's group settings (keeps the last working ones on failure)
ExecStart=-/usr/local/sbin/kiosk-config apply --fetch
StandardOutput=journal
StandardError=journal
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
