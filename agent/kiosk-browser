#!/bin/sh
# Runs inside cage as the kiosk user: a branded splash stays open behind the
# browser, and Chromium is restarted with a fresh profile whenever it closes.
RUN=/run/kiosk
PROFILE=$RUN/chromium
STATUS=$RUN/splash-status

/usr/local/bin/kiosk-splash &

# When the service stops, close everything right away instead of restarting
# the browser (which held up the switch to the admin screen).
trap 'trap - TERM INT HUP; pkill -P $$; exit 0' TERM INT HUP

status() { echo "$1" > "$STATUS"; }

while true; do
    # Wait up to 30 s for the network so the home pages load on the first try
    status "Connecting…"
    i=0
    while [ $i -lt 30 ] && ! ip route | grep -q '^default'; do
        sleep 1
        i=$((i + 1))
    done
    status "Starting…"

    rm -rf "$PROFILE"
    # Run in the background and wait, so the trap above fires immediately
    /usr/bin/chromium --no-first-run --noerrdialogs --ozone-platform=wayland \
        --user-data-dir="$PROFILE" &
    wait $!
    status "Starting a new session…"
    sleep 1
done
